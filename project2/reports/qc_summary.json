  "rules": {
    "A_stuck_zero": "run of consecutive station-days with data and exact-zero total (no-data days do not break it) containing >= 3 days whose hour-matched neighbour median >= 5.0 mm (>= 3 neighbours); whole run masked",
    "B_isolated_extreme": "station-day total >= 100.0 mm and wettest hour-matched neighbour < 15% of it (>= 3 neighbours); day +-1 masked",
    "C_phantom_rain": "station-day total >= 20.0 mm with >= 1.0 mm in >= 3 different hours, wettest of >= 5 hour-matched neighbours <= 5% of it; day +-1 masked",
    "D_repeat": ">= 3 B/C days at a station with consecutive flags <= 30 days apart; span first..last +-1 day masked",
    "E_spike": "single 5-min value >= 5.0 mm, own previous and next readings < 10% of it, and no reading >= 1.0 mm at any of the 8 nearest neighbours within 10.0 km (>= 3 reporting) within +-30 min; that slot masked",
    "neighbours": "stations within 10.0 km; daily totals are hour-matched (only hours in which the station reported), a neighbour must cover >= 80% of those hours, nearest 8 used"
  },
