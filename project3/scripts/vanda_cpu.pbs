#!/bin/bash
#PBS -N chess-cpu
#PBS -j oe
#PBS -V
#PBS -l select=1:ncpus=4:mpiprocs=1:ompthreads=4:mem=8gb
#PBS -l walltime=00:15:00

set -euo pipefail
cd "$PBS_O_WORKDIR"

# Change the PBS select line and JOB_THREADS together for larger runs.
threads="${JOB_THREADS:-4}"
depth="${JOB_DEPTH:-4}"
split_depth="${JOB_SPLIT_DEPTH:-2}"
backend="${JOB_BACKEND:-mpi}"
binding="${JOB_BINDING:-none}"
repeats="${JOB_REPEATS:-1}"
fen="${JOB_FEN:-rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1}"
ranks="$(wc -l < "$PBS_NODEFILE")"
if [[ "$backend" != mpi && "$backend" != mpi-pv && "$backend" != serial ]]; then
  echo "JOB_BACKEND must be mpi, mpi-pv, or serial" >&2
  exit 2
fi
if [[ "$backend" == mpi-pv && "$split_depth" != 1 ]]; then
  echo "mpi-pv requires JOB_SPLIT_DEPTH=1" >&2
  exit 2
fi
if [[ "$backend" == serial && ( "$ranks" != 1 || "$split_depth" != 1 ) ]]; then
  echo "serial baseline requires one MPI rank and JOB_SPLIT_DEPTH=1" >&2
  exit 2
fi
if [[ "$binding" != none && "$binding" != default ]]; then
  echo "JOB_BINDING must be none or default" >&2
  exit 2
fi
if [[ ! "$repeats" =~ ^[1-9][0-9]*$ ]]; then
  echo "JOB_REPEATS must be a positive integer" >&2
  exit 2
fi
mpi_binding=()
if [[ "$binding" == none ]]; then
  mpi_binding=(--bind-to none)
fi
output_dir="results/${PBS_JOBID:-manual}"
mkdir -p "$output_dir"

command -v mpic++
command -v mpirun
command -v g++
stdlib_file="$(g++ -print-file-name=libstdc++.so.6)"
openmp_file="$(g++ -print-file-name=libgomp.so.1)"
test -f "$stdlib_file"
test -f "$openmp_file"
export LD_LIBRARY_PATH="$(dirname "$stdlib_file"):$(dirname "$openmp_file"):${LD_LIBRARY_PATH:-}"
make mpi

{
  date -u
  printf 'job=%s backend=%s ranks=%s threads=%s depth=%s split_depth=%s binding=%s repeats=%s\n' \
    "${PBS_JOBID:-manual}" "$backend" "$ranks" "$threads" "$depth" "$split_depth" "$binding" "$repeats"
  sha256sum src/main.cpp scripts/vanda_cpu.pbs
  printf 'nodes:\n'
  sort -u "$PBS_NODEFILE"
  printf 'GCC runtime libraries resolved by the launcher:\n'
  ldd ./build/chess_search_mpi | grep -E 'libstdc\+\+|libgomp'
  for ((trial = 1; trial <= repeats; ++trial)); do
    printf 'trial=%s\n' "$trial"
    mpirun "${mpi_binding[@]}" --report-bindings -x LD_LIBRARY_PATH -x PATH -np "$ranks" \
      ./build/chess_search_mpi --backend "$backend" \
      --threads "$threads" --depth "$depth" --split-depth "$split_depth" \
      --fen "$fen"
  done
} 2>&1 | tee "$output_dir/run.txt"
