#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo 'Usage: git sync-hpc [--dry-run]' >&2
}

rsync_options=()
if (( $# == 1 )) && [[ "$1" == '--dry-run' ]]; then
  rsync_options+=(--dry-run)
elif (( $# != 0 )); then
  usage
  exit 2
fi

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -z "${CHESS_HPC_DEST:-}" ]]; then
  echo 'Set CHESS_HPC_DEST to your own Vanda destination, for example NUSNETID@vanda.nus.edu.sg:~/dsa5208/project3/' >&2
  exit 2
fi
destination="$CHESS_HPC_DEST"

printf 'Syncing %s/ to %s\n' "$project_dir" "$destination"
rsync -avz --itemize-changes "${rsync_options[@]}" \
  --exclude='/.git/' \
  --exclude='/.agents/' \
  --exclude='/.codex/' \
  --exclude='/.aws/' \
  --exclude='/build/' \
  --exclude='/results/' \
  --exclude='/logs/' \
  --exclude='/figures/*.aux' \
  --exclude='/figures/*.log' \
  --exclude='/report/*.aux' \
  --exclude='/report/*.log' \
  --exclude='/report/*.out' \
  "$project_dir/" "$destination"
